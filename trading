    plt.xlabel('Fecha/Hora')
    plt.ylabel('Balance')
    plt.legend()
    plt.grid()
    plt.show()

    rolling_max = df['balance'].cummax()
    drawdown = (rolling_max - df['balance']) / rolling_max
    max_dd = drawdown.max()
    print(f"Máximo Drawdown: {max_dd:.2%}")

    trades = df[df['signal'].notnull()]
