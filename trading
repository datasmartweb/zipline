async def get_balance(ws):
    await ws.send(json.dumps({"balance": 1}))
    while True:
        msg = await ws.recv()
        data = json.loads(msg)
        if data.get("msg_type") == "balance":
            if isinstance(data["balance"], dict) and "balance" in data["balance"]:
                return float(data["balance"]["balance"])
            elif isinstance(data["balance"], (float, int, str)):
                return float(data["balance"])
            else:
                return 0.0
        if data.get("msg_type") == "authorize" and "balance" in data.get("authorize", {}):
            return float(data["authorize"]["balance"])

