def train_and_validate():
    try:
        # Paso 1: Verificar si el archivo histórico existe
        if not os.path.exists(HIST_FILE):
            print(f"📥 Descargando histórico de velas para {SYMBOL} ...")
            asyncio.run(download_candles())

        # Paso 2: Cargar y validar datos
        df = pd.read_csv(HIST_FILE)
        if 'time' not in df.columns:
            raise ValueError(f"❌ El archivo {HIST_FILE} NO contiene la columna 'time'. Columnas: {df.columns.tolist()}")

        df['time'] = pd.to_datetime(df['time'])
        df = df.set_index('time')

        # Paso 3: Ingeniería de características
        df = advanced_feature_engineering(df)

        # Paso 4: Definir variable objetivo
        df = define_target(df, lookahead=2)
        df = df[df['target'] != -1]

        # Paso 5: Selección de características
        features = [c for c in df.columns if c != 'target']
        df = df[features + ['target']].dropna()

        # Paso 6: Escalado
        X = df[features].values
        y = df['target'].values
        X = validate_data(X)  # limpia NaN e infinitos si los hay

        scaler = StandardScaler()
        X_scaled = scaler.fit_transform(X)
        joblib.dump(scaler, SCALER_FILE)

        # Paso 7: Balanceo de datos
        X_bal, y_bal = balance_data(X_scaled, y)

        # Paso 8: Entrenamiento de modelos base
        rf = RandomForestClassifier(n_estimators=150, max_depth=8, class_weight='balanced', random_state=42)
        xgb = XGBClassifier(n_estimators=150, max_depth=8, learning_rate=0.04,
                            use_label_encoder=False, eval_metric='logloss')

        rf.fit(X_bal, y_bal)
        xgb.fit(X_bal, y_bal)
        joblib.dump(rf, RF_FILE)
        joblib.dump(xgb, XGB_FILE)

        # Paso 9: Entrenar red neuronal
        nn_model = build_deep_nn(X_bal.shape[1], lr=0.001, dropout=0.2)
        nn_model.fit(X_bal, y_bal, epochs=30, batch_size=32, verbose=0)
        nn_model.save(MODEL_FILE)

        # Paso 10: Predicciones para ensamble
        nn_pred = nn_model.predict(X_bal).flatten()
        rf_pred = rf.predict_proba(X_bal)[:, 1]
        xgb_pred = xgb.predict_proba(X_bal)[:, 1]

        meta_X = np.column_stack([nn_pred, rf_pred, xgb_pred])
        stack_model = LogisticRegression()
        stack_model.fit(meta_X, y_bal)
        joblib.dump(stack_model, STACK_FILE)

        # Paso 11: Ajuste de umbrales
        probs = stacking_ensemble_predict(X_bal, nn_model, rf, xgb, stack_model)
        best_call, best_put = optimize_balanced_thresholds(probs, y_bal, min_precision=0.60, min_signals=15)

        with open(THRESHOLD_FILE, 'w') as f:
            json.dump({'threshold_call': float(best_call), 'threshold_put': float(best_put)}, f)

        with open(FEATURES_FILE, 'w') as f:
            json.dump(features, f)

        # Paso 12: Resumen
        print(f"🎯 Entrenamiento completo.\nCALL={best_call:.2f} | PUT={best_put:.2f}")
