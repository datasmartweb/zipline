# --- NUEVOS INDICADORES DE MICROESTRUCTURA (para DataFrame histórico y en vivo) ---
def add_microstructure_features(df, price_col="close", window=20, accel_window=10, density_window=50):
    df = df.copy()
    # Tick direction: +1 si sube, -1 si baja, 0 si igual
    df["tick_direction"] = np.sign(df[price_col].diff())
    # Tick imbalance: suma de direcciones en ventana corta
    df["tick_imbalance"] = df["tick_direction"].rolling(window).sum()
    # Presión: promedio de direcciones recientes
    df["buy_sell_pressure"] = df["tick_direction"].rolling(window).mean()
    # Volatilidad local
    df["micro_volatility"] = df[price_col].rolling(window).std()
    # Aceleración (segunda derivada)
    velocity = df[price_col].diff()
    acceleration = velocity.diff()
    df["price_acceleration"] = acceleration.rolling(accel_window).mean()
    # Densidad de cambios de dirección
    direction_changes = (df["tick_direction"].shift(-1) != df["tick_direction"]).astype(int)
    df["direction_change_density"] = direction_changes.rolling(density_window).mean()
    return df


def advanced_feature_engineering(df):
    df = df.copy()
    for period in [3, 7, 14, 21]:
        df[f'rsi_{period}'] = ta.rsi(df['close'], length=period)
    for period in [7, 14, 21]:
        df[f'atr_{period}'] = ta.atr(df['high'], df['low'], df['close'], length=period)
        adx = ta.adx(df['high'], df['low'], df['close'], length=period)
        df[f'adx_{period}'] = adx[f'ADX_{period}']
        df[f'cci_{period}'] = ta.cci(df['high'], df['low'], df['close'], length=period)
        df[f'williams_{period}'] = ta.willr(df['high'], df['low'], df['close'], length=period)
    stochrsi = ta.stochrsi(df['close'])
    if stochrsi is not None:
        df['stochrsi_k'] = stochrsi['STOCHRSIk_14_14_3_3']
        df['stochrsi_d'] = stochrsi['STOCHRSId_14_14_3_3']
    for period in [5, 10, 20, 50, 100]:
        df[f'sma_{period}'] = ta.sma(df['close'], length=period)
        df[f'ema_{period}'] = ta.ema(df['close'], length=period)
    bb = ta.bbands(df['close'], length=20)
    df['bb_upper'] = bb['BBU_20_2.0']
    df['bb_middle'] = bb['BBM_20_2.0']
    df['bb_lower'] = bb['BBL_20_2.0']
    macd = ta.macd(df['close'])
    df['macd'] = macd['MACD_12_26_9']
    df['macd_signal'] = macd['MACDs_12_26_9']
    df['macd_hist'] = macd['MACDh_12_26_9']
    df['roc_10'] = ta.roc(df['close'], length=10)
    df['mom_10'] = ta.mom(df['close'], length=10)
    df['volatility_10'] = df['close'].rolling(10).std()
    df['volatility_20'] = df['close'].rolling(20).std()
    df['close_ema10_ratio'] = df['close'] / (df['ema_10'] + 1e-9)
    df['close_sma20_ratio'] = df['close'] / (df['sma_20'] + 1e-9)
    df['price_position_in_band'] = (df['close'] - df['bb_lower']) / (df['bb_upper'] - df['bb_lower'] + 1e-9)
    df['close_rolling_mean_10'] = df['close'].rolling(10).mean()
    df['close_rolling_std_10'] = df['close'].rolling(10).std()
    df['close_rolling_min_10'] = df['close'].rolling(10).min()
    df['close_rolling_max_10'] = df['close'].rolling(10).max()
    df['close_pct_change_5'] = df['close'].pct_change(5)
    df['high_low_range'] = df['high'] - df['low']
    df['body'] = abs(df['close'] - df['open'])
    df['upper_shadow'] = df['high'] - np.maximum(df['close'], df['open'])
    df['lower_shadow'] = np.minimum(df['close'], df['open']) - df['low']
    df['diff_close'] = df['close'].diff()
    df['diff_ema10'] = df['ema_10'].diff()
    for N in [3, 5, 10]:
        df[f'perc_bull_{N}'] = df['close'].rolling(N).apply(lambda x: np.sum(x > x.shift(1)) / N if len(x.dropna()) == N else np.nan, raw=False)
        df[f'perc_bear_{N}'] = df['close'].rolling(N).apply(lambda x: np.sum(x < x.shift(1)) / N if len(x.dropna()) == N else np.nan, raw=False)

    # --- NUEVO: microestructura ---
    df = add_microstructure_features(df, price_col="close", window=20, accel_window=10, density_window=50)
    df = df.replace([np.inf, -np.inf], np.nan)
    df = df.dropna()
    return df

def preparar_datos_modelo(df, label_column='target'):
    df = df.copy()
    df.dropna(inplace=True)
    features = [col for col in df.columns if col not in ['time', 'open', 'high', 'low', 'close', label_column]]
    with open(FEATURES_FILE, 'w') as f:
        json.dump(features, f)
    X = df[features]
    y = df[label_column]
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    joblib.dump(scaler, SCALER_FILE)
    print(f"✅ Datos preparados con {len(features)} features y {len(X_scaled)} muestras.")
    return X_scaled, y

def define_target(df, lookahead=2, atr_period=14, atr_mult=0.05):
    df = df.copy()
    df['target'] = -1
    c = df['close'].values
    atr = ta.atr(df['high'], df['low'], df['close'], length=atr_period).values
    for i in range(len(c) - lookahead):
        move = (c[i+lookahead] - c[i]) / c[i]
        threshold = (atr[i] * atr_mult) / c[i] if not np.isnan(atr[i]) else 0
        if move > threshold:
            df.iloc[i, df.columns.get_loc('target')] = 1
        elif move < -threshold:
            df.iloc[i, df.columns.get_loc('target')] = 0
    return df

def balance_data(X, y):
    counts = np.bincount(y)
    ratio = min(counts) / max(counts)
    if ratio < 0.5:
        smote = SMOTE()
        X_bal, y_bal = smote.fit_resample(X, y)
        print("🔄 SMOTE aplicado (oversampling).")
    else:
        rus = RandomUnderSampler()
        X_bal, y_bal = rus.fit_resample(X, y)
        print("🔄 Submuestreo aplicado (undersampling).")
    return X_bal, y_bal

def build_deep_nn(input_dim, lr=0.001, dropout=0.3):
    model = Sequential([
        Input(shape=(input_dim,)),
        Dense(128, activation='relu'),
        BatchNormalization(),
        Dropout(dropout),
        Dense(64, activation='relu'),
        BatchNormalization(),
        Dropout(dropout),
        Dense(32, activation='relu'),
        Dropout(dropout/2),
        Dense(1, activation='sigmoid')
    ])
    model.compile(optimizer=Adam(lr), loss='binary_crossentropy', metrics=['accuracy'])
    return model

def stacking_ensemble_predict(X, nn_model, rf_model, xgb_model, stack_model):
    nn_pred = nn_model.predict(X).flatten()
    rf_pred = rf_model.predict_proba(X)[:, 1]
    xgb_pred = xgb_model.predict_proba(X)[:, 1]
    meta_X = np.column_stack([nn_pred, rf_pred, xgb_pred])
    return stack_model.predict_proba(meta_X)[:, 1]

def optimize_balanced_thresholds(probs, y_true, min_precision=0.6, min_signals=10):
    thresholds = np.arange(0.15, 0.9, 0.01)
    best_call, best_put = 0.7, 0.2
    best_balance = 0
    best_stats = {}
    for t_call in thresholds:
        for t_put in thresholds:
            if t_put >= t_call:
                continue
            pred = np.full_like(probs, fill_value=-1)
            pred[probs >= t_call] = 1
            pred[probs <= t_put] = 0
            mask = pred != -1
            if np.sum(mask) < min_signals:
                continue
            call_mask = (pred == 1)
            put_mask = (pred == 0)
            if np.sum(call_mask) < min_signals or np.sum(put_mask) < min_signals:
                continue
            prec_call = precision_score(y_true[call_mask], pred[call_mask], zero_division=0)
            prec_put  = precision_score(y_true[put_mask], pred[put_mask], zero_division=0)
            if prec_call < min_precision or prec_put < min_precision:
                continue
            n_call = np.sum(call_mask)
            n_put = np.sum(put_mask)
            balance = 1.0 - abs(n_call - n_put) / (n_call + n_put)
            if balance > best_balance:
                best_balance = balance
                best_call = t_call
                best_put = t_put
                best_stats = dict(n_call=n_call, n_put=n_put, prec_call=prec_call, prec_put=prec_put)
    print(f"Thresholds óptimos balanceados: CALL>={best_call:.2f} [{best_stats.get('n_call',0)} señales, {best_stats.get('prec_call',0):.2f} precisión], "
          f"PUT<={best_put:.2f} [{best_stats.get('n_put',0)} señales, {best_stats.get('prec_put',0):.2f} precisión], "
          f"Balance={best_balance:.3f}")
    return best_call, best_put

