    losses = trades[trades['pnl'] < 0]
    winrate = len(wins) / max(1, len(trades))
    profit_factor = wins['pnl'].sum() / (-losses['pnl'].sum()) if len(losses) > 0 else np.nan
    print(f"Winrate: {winrate:.2%}")
    print(f"Profit Factor: {profit_factor:.2f}")

    print("\nResultado por hora:")
    print(trades.groupby('hour')['pnl'].sum())
    print("\nResultado por día:")
    print(trades.groupby('day')['pnl'].sum())

    plt.figure(figsize=(12,4))
    plt.hist(trades['pnl'], bins=50)
    plt.title('Distribución de PnL por trade')
    plt.grid()
    plt.show()
