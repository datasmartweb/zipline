def validate_data(data):
    if np.any(np.isnan(data)):
        data = np.nan_to_num(data, nan=0.0)
    if np.any(np.isinf(data)):
        data = np.nan_to_num(data, posinf=1e6, neginf=-1e6)
    return data

def calcular_umbral_volatilidad_dinamico(df, window=200, percentil=10, min_val=0.2):
    atr_rel = (df['atr_14'] / df['close']).dropna()
    if len(atr_rel) < window:
        return min_val
    recent = atr_rel[-window:]
    return max(np.percentile(recent, percentil), min_val)

async def download_candles(symbol=SYMBOL, granularity=GRANULARITY, total=HIST_CANDLES, output_file=HIST_FILE):
    all_candles = []
    latest_epoch = None
    candles_needed = total
    MAX_PER_REQUEST = 1000
    async with websockets.connect(URL) as ws:
        while candles_needed > 0:
            count = min(MAX_PER_REQUEST, candles_needed)
            req = {
                "ticks_history": symbol,
                "count": count,
                "style": "candles",
                "granularity": granularity,
            }
            if latest_epoch is not None:
                req["end"] = latest_epoch - 1
            else:
                req["end"] = int(time.time())
            await ws.send(json.dumps(req))
            msg = await ws.recv()
            data = json.loads(msg)
            if "candles" not in data:
                print("❌ Error al descargar velas:", data)
                break
            candles = data["candles"]
            if not candles:
                break
            all_candles = candles + all_candles
            candles_needed -= len(candles)
            latest_epoch = candles[0]["epoch"]
            print(f"Descargadas: {len(candles)} | Total acumulado: {len(all_candles)}")
            if len(candles) < count:
                break
    if not all_candles:
        print("❌ No se descargó ninguna vela.")
        return
    df = pd.DataFrame(all_candles)
    if 'epoch' in df.columns:
        df.rename(columns={"epoch": "time"}, inplace=True)
    df["time"] = pd.to_datetime(df["time"], unit="s")
    df = df[["time", "open", "high", "low", "close"]]
    df.sort_values("time", inplace=True)
    df.to_csv(output_file, index=False)
    print(f"✅ Histórico guardado en {output_file}")
    send_telegram_alert(f"✅ Histórico guardado en {output_file}")

