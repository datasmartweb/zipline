# --- FUNCIONES DE PARSEO DE TICK ---
def parse_price(msg):
    return float(msg["tick"]["quote"])

def parse_time_bucket(msg):
    epoch = int(msg["tick"]["epoch"])
    dt = datetime.utcfromtimestamp(epoch)
    bucket_minute = (dt.minute // TIMEFRAME_MINUTES) * TIMEFRAME_MINUTES
    return dt.replace(second=0, microsecond=0, minute=bucket_minute)

def round_down_to_timeframe(dt):
    return dt - timedelta(
        minutes=dt.minute % TIMEFRAME_MINUTES,
        seconds=dt.second,
        microseconds=dt.microsecond
    )


