# --- Signal function (con microestructura) ---
def signal_fn(features_row, model=None, scaler=None):
    X = features_row.drop(columns=['time'], errors='ignore').values
    if scaler is not None:
        X = scaler.transform(X)
    prob = model.predict_proba(X)[0,1] if model is not None else 0.5
    # Decisión simple
    if prob > 0.7:
        signal = "CALL"
    elif prob < 0.3:
        signal = "PUT"
    else:
        signal = None
    last = features_row.iloc[0]
    # Filtros microestructura
    passed = True
    if signal == 'CALL':
        passed = (
            last['tick_imbalance'] > 3 and
            last['buy_sell_pressure'] > 0.2 and
            last['price_acceleration'] > 0 and
            last['micro_volatility'] > 1e-4 * last['close'] and
            last['direction_change_density'] < 0.5
        )
    elif signal == 'PUT':
        passed = (
            last['tick_imbalance'] < -3 and
            last['buy_sell_pressure'] < -0.2 and
            last['price_acceleration'] < 0 and
            last['micro_volatility'] > 1e-4 * last['close'] and
            last['direction_change_density'] < 0.5
        )
    if not passed:
        signal = None
    return signal, prob

# --- Gestión de riesgo (Kelly + mínimo fijo) ---
def risk_fn(balance, prob, signal, kelly_fraction=1.0, base_fraction=0.05):
    if not signal:
        return 0
    edge = 2*prob - 1 if signal in ["CALL", "PUT"] else 0
    kelly = max(edge, 0) * kelly_fraction
    bet = balance * max(kelly, base_fraction)
    return min(bet, balance)

# --- Backtest tick por tick ---
def backtest_tick_by_tick(df_ticks, features_fn, model, scaler, initial_balance=1000, buffer_size=100, verbose=True):
    balance = initial_balance
    max_balance = initial_balance
    equity_curve = []
    log = []
    buffer = deque(maxlen=buffer_size)
    last_bar_time = None
    for i, row in df_ticks.iterrows():
        bar_time = row['time']
        price = row['close']
        buffer.append({'open': row['open'], 'high': row['high'], 'low': row['low'], 'close': row['close'], 'time': bar_time})
        if len(buffer) < buffer_size:
            continue
        if last_bar_time is not None and bar_time <= last_bar_time:
            continue
        last_bar_time = bar_time
        df_temp = pd.DataFrame(list(buffer)).set_index('time')
        df_feat = features_fn(df_temp)
        if df_feat.empty:
            continue
        df_feat = df_feat.dropna()
        features_row = df_feat.iloc[-1:]
        signal, prob = signal_fn(features_row, model=model, scaler=scaler)
        bet_size = risk_fn(balance, prob, signal)
        pnl = 0
        if signal and bet_size > 0:
            future_idx = min(i+1, len(df_ticks)-1)
            future_close = df_ticks.iloc[future_idx]['close']
            if signal == 'CALL':
                pnl = (future_close - price) * (bet_size / price)
            elif signal == 'PUT':
                pnl = (price - future_close) * (bet_size / price)
            balance += pnl
            max_balance = max(max_balance, balance)
            if verbose:
                print(f"{bar_time}: {signal} | Prob: {prob:.3f} | Bet: {bet_size:.2f} | PnL: {pnl:.2f} | Balance: {balance:.2f}")
        equity_curve.append(balance)
        log.append({
            'time': bar_time,
            'signal': signal,
            'prob': prob,
            'bet': bet_size,
            'pnl': pnl,
            'balance': balance,
            'drawdown': (max_balance - balance) / max_balance,
        })
    df_log = pd.DataFrame(log)
    # Reportes automáticos
    df_log['hour'] = pd.to_datetime(df_log['time']).dt.hour
    df_log['day'] = pd.to_datetime(df_log['time']).dt.date
    print("Resultados por hora:\n", df_log.groupby('hour')['pnl'].sum())
    print("Resultados por día:\n", df_log.groupby('day')['pnl'].sum())
    print("Máximo drawdown:", df_log['drawdown'].max())
    plt.figure(figsize=(12,5))
    plt.plot(df_log['time'], df_log['balance'])
    plt.title('Equity curve')
    plt.show()
    try:
        profile = df_log.profile_report(title="Backtest Report")
        profile.to_file("backtest_report.html")
    except Exception:
        pass
    return df_log

def generar_reporte_diario(log_path="registro_operaciones_3m.csv", output_path=None):
    df = pd.read_csv(log_path, parse_dates=['datetime'])
    df['day'] = df['datetime'].dt.date

    for dia, df_day in df.groupby('day'):
        total_ops = len(df_day)
        wins = (df_day['profit'] > 0).sum()
        winrate = wins / total_ops if total_ops else 0
        profit = df_day['profit'].sum()
        balance_final = df_day['profit'].cumsum().iloc[-1] if not df_day.empty else None
        equity = df_day['profit'].cumsum()
        rolling_max = equity.cummax()
        drawdown = ((rolling_max - equity).max() if not equity.empty else 0)
        breakdown = []
        for tipo in ['CALL', 'PUT']:
            subset = df_day[df_day['tipo_senal'] == tipo]
            n = len(subset)
            w = (subset['profit'] > 0).sum()
            wr = w / n if n else 0
            pf = subset['profit'].sum()
            breakdown.append(f"{tipo}: {n} ops | Winrate: {wr:.2%} | Net: {pf:.2f}")
        reporte = (
            f"📊 Reporte diario del {dia}\n"
            f"Operaciones totales: {total_ops}\n"
            f"Winrate: {winrate:.2%}\n"
            f"Ganancia/Pérdida neta: {profit:.2f}\n"
            f"Drawdown máximo: {drawdown:.2f}\n"
            f"Balance relativo: {balance_final:.2f}\n"
            "Breakdown por tipo de señal:\n  " + "\n  ".join(breakdown) + "\n"
            "------------------------\n"
        )
        nombre_archivo = output_path or f"reporte_diario_{dia}.txt"
        with open(nombre_archivo, "w") as f:
            f.write(reporte)
        print(f"Reporte diario guardado en {nombre_archivo}")
        print(reporte)

